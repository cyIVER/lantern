# Secrets — never commit
.env
*.env
!.env.example

# Stardew: mod folders and runtime output are local, not source
stardew/mods/*
!stardew/mods/.gitkeep
stardew/settings/
stardew/diagnostics/

# Runtime data
data/
volumes/
demos/
logs/
*.log

# OS
Thumbs.db
desktop.ini
.DS_Store

# Python
.venv/
__pycache__/
*.pyc

# WeaponPaints DB credentials (generated)
.weaponpaints-db
stack/.weaponpaints-db
stack/startup.log

ui/.env
ui/.venv/
ui/static/maps/*.svg
