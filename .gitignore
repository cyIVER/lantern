# Secrets — never commit
.env
*.env
!.env.example
stack/secrets/

# Stardew: mod folders and runtime output are local, not source
stardew/mods/*
!stardew/mods/.gitkeep
stardew/settings/
stardew/diagnostics/

# Runtime data
data/
volumes/
demos/
logs/
*.log

# OS
Thumbs.db
desktop.ini
.DS_Store

# Python
.venv/
.pytest_cache/
__pycache__/
*.pyc
*.egg-info/

# WeaponPaints DB credentials (generated)
.weaponpaints-db
stack/.weaponpaints-db
stack/startup.log

ui/.env
ui/.venv/
ui/static/maps/*.svg

# Handed-over credentials, delete after use
stack/.scotland-login
