# Copy to .env and fill in. Real .env is gitignored.
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
APP_URL=http://192.168.0.115
TZ=America/Chicago

# Bind the Minecraft UI only to LANtern's reserved LAN address. CI overrides
# this with 127.0.0.1; do not use 0.0.0.0 on an internet-routed host.
LANTERN_MINECRAFT_UI_BIND_IP=192.168.0.115
# Set true only after an HTTPS reverse proxy protects port 8093.
MINECRAFT_SECURE_COOKIE=false
# Numeric group that owns stack/secrets on the VM (`id -g` for its creator).
LANTERN_SECRET_GID=1000
