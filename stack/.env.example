# Copy to .env and fill in. Real .env is gitignored.
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
APP_URL=http://192.168.0.115
TZ=America/Chicago

# Required before the Minecraft schematic sidecar can be started. Use a
# released GHCR image pinned by digest; mutable tags such as latest are unsafe.
SCHEMATIC_VIEWER_IMAGE=ghcr.io/scotsgamez/create-schematic-viewer:<release>@sha256:<digest>
