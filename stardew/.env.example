# Copy to stardew/.env and fill in. The real .env is gitignored.
#
#   cp stardew/.env.example stardew/.env
#
# This repository is PUBLIC. Nothing here belongs in git, and the Steam values
# must never become GitHub secrets either -- see docs/SECRETS.md.

# ---------------------------------------------------------------- required --

# The Steam account that owns Stardew Valley. Used to download the game you
# already paid for; there is no way around it, because Valve does not allow
# anonymous downloads of paid titles.
#
# Consider an account that owns only Stardew rather than your main one.
STEAM_USERNAME=""
STEAM_PASSWORD=""

# Protects the web VNC console, which can drive the running game. Anyone on the
# LAN who reaches port 5800 gets full control of the farm without it.
# Generate one:  openssl rand -base64 24
VNC_PASSWORD=""

# ------------------------------------------------------------ after setup --

# Once the interactive login has succeeded, trade the password for a token:
#
#   cd stardew && docker compose run --rm steam-auth export-token
#
# then paste it here and BLANK STEAM_PASSWORD above. The token only grants
# Steam downloads, so a leak is far less damaging than a password.
STEAM_REFRESH_TOKEN=""

# ---------------------------------------------------------------- security --

# Protects the HTTP API's write endpoints. Generate:  openssl rand -base64 32
API_KEY=""

# Require players to type !login <password> after joining. Empty disables it.
# On a LAN this is usually unnecessary.
SERVER_PASSWORD=""

# ------------------------------------------------------------------- ports --
# Host-side only. Two differ from upstream because LANtern already uses theirs:
#   QUERY_PORT  27015 -> 27030   (CS2 has 27015 in Pelican)
#   API_PORT     8080 -> 8091    (Wings has 8080)

GAME_PORT=24642
QUERY_PORT=27030
VNC_PORT=5800
API_PORT=8091

# -------------------------------------------------------------- behaviour --

# Ticks per second. 60 is the max and the default; 30 roughly halves CPU on a
# farm that is idle most of the time, which matters on a box that also hosts
# Minecraft.
SERVER_TPS=30

# Frames per second for VNC. 0 disables rendering. Raise it only while you are
# actually looking at the VNC console.
SERVER_FPS=0

# There is no usable stable channel. sdvd/server publishes "latest" (built
# 2026-01-07) but sdvd/steam-service never has, so the only tags both images
# share are preview builds. Pinned to a matched pair rather than the floating
# "preview" tag, which moves daily.
IMAGE_VERSION=1.5.0-preview.127

# ---------------------------------------------------------- discord bot --
# Optional, and NOT the same thing as the webhook the modpack CI posts with.
# This is a real bot: live status embed plus two-way chat relay.
#   docker compose --profile discord up -d
DISCORD_BOT_TOKEN=""
DISCORD_CHAT_CHANNEL_ID=""
STATUS_DASHBOARD_CHANNEL_ID=""
